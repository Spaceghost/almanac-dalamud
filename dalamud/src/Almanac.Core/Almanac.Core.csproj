<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that needs no game: model client, MCP client, agent loop, setup detection, benchmark, SQLite store. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Almanac.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the Python engine byte for byte; the suite hash is over these bytes. -->
    <EmbeddedResource Include="../../../benchmark/suites/ffxiv-core.json" LogicalName="Almanac.Core.suites.ffxiv-core.json" />
    <EmbeddedResource Include="../../../benchmark/recommendations.json" LogicalName="Almanac.Core.recommendations.json" />
    <InternalsVisibleTo Include="Almanac.Core.Tests" />
  </ItemGroup>
</Project>
