  "tasks": [
    {
      "id": "where_am_i",
      "category": "location",
      "prompt": "Where am I right now? Tell me the zone and my map coordinates.",
      "tools": ["get_location", "get_weather_forecast", "list_aetherytes"],
      "expect": {
        "calls": [ { "name": "get_location" } ],
        "answer": {
          "contains_from_tool": [ { "tool": "get_location", "path": "territory.name" } ],
          "numbers_from_tool": [ { "tool": "get_location", "path": "mapCoordinates.x", "tolerance": 0.15 }, { "tool": "get_location", "path": "mapCoordinates.y", "tolerance": 0.15 } ]
        }
      }
    },
    {
      "id": "nearest_aetheryte",
      "category": "location",
      "prompt": "Which aetheryte is closest to me right now?",
      "tools": ["get_location", "list_aetherytes"],
      "expect": {
        "calls": [ { "name": "get_location" } ],
        "answer": { "contains_from_tool": [ { "tool": "get_location", "path": "nearestAetheryte.name" } ] }
      }
    },
    {
      "id": "weather_next_here",
      "category": "weather",
      "prompt": "What will the weather be in the next weather window here, after the current one?",
      "tools": ["get_location", "get_weather_forecast"],
      "expect": {
        "calls": [ { "name": "get_weather_forecast" } ],
        "answer": { "contains_from_tool": [ { "tool": "get_weather_forecast", "path": "forecast[1].name" } ] }
      }
    },
    {
      "id": "weather_rain_zone",
      "category": "weather",
      "prompt": "Check the forecast for territory id 135 (Lower La Noscea): is Rain coming in the next 6 weather windows? Answer yes or no, and name the window's Eorzea start time if yes.",
      "tools": ["get_location", "get_weather_forecast"],
      "expect": {
        "calls": [ { "name": "get_weather_forecast", "args": { "territoryId": { "eq": 135 } } } ],
        "answer": { "contains_any": ["yes"], "contains_all": ["00:00"], "not_contains": ["no rain"] }
      },
      "live": { "answer": "skip" }
    },
    {
      "id": "teleport_cost",
      "category": "aetheryte",
      "prompt": "How much gil does a teleport to Moraby Drydocks cost me?",
      "tools": ["get_location", "list_aetherytes"],
      "expect": {
        "calls": [ { "name": "list_aetherytes" } ],
        "answer": { "numbers_from_tool": [ { "tool": "list_aetherytes", "path": "aetherytes[name~Moraby].gilCost", "tolerance": 0 } ] }
      }
    },
    {
      "id": "aetherytes_filtered",
      "category": "aetheryte",
      "prompt": "List my teleport destinations in La Noscea only (not the city).",
      "tools": ["list_aetherytes"],
      "expect": {
        "calls": [ { "name": "list_aetherytes", "args": { "nameContains": { "icontains_any": ["noscea"] } } } ],
        "answer": { "contains_all": ["Summerford Farms", "Moraby Drydocks", "Costa del Sol"] }
      },
      "live": { "answer": "skip" }
    },
    {
      "id": "flag_coordinates",
      "category": "map",
      "prompt": "Put a map flag at X 11.2, Y 14.5 in my current zone.",
      "tools": ["get_location", "set_map_flag"],
      "expect": {
        "calls": [ { "name": "set_map_flag", "args": { "x": { "approx": 11.2, "tolerance": 0.05 }, "y": { "approx": 14.5, "tolerance": 0.05 } } } ],
        "answer": { "contains_any": ["11.2", "flag"] }
      }
    },
    {
      "id": "quest_level",
      "category": "quest",
      "prompt": "What level is the quest \"It's Probably Pirates\"?",
      "tools": ["search_quests"],
      "expect": {
        "calls": [ { "name": "search_quests", "args": { "query": { "icontains_any": ["pirate"] } } } ],
        "answer": { "numbers_from_tool": [ { "tool": "search_quests", "path": "results[name~Pirates].level", "tolerance": 0 } ] }
      }
    },
    {
      "id": "command_gearset",
      "category": "command",
      "prompt": "Give me the exact slash command to switch to gear set 3. Reply with only the command. Do not run it.",
      "tools": [],
      "expect": { "calls": [], "answer": { "exact": "/gearset change 3" } }
    },
    {
      "id": "command_hudlayout",
      "category": "command",
      "prompt": "What slash command switches my HUD to layout 2? Reply with only the command.",
      "tools": [],
      "expect": { "calls": [], "answer": { "exact": "/hudlayout 2" } }
    },
    {
      "id": "restraint_general",
      "category": "restraint",
      "prompt": "In one sentence: what is the Duty Finder for?",
      "tools": ["get_location", "get_weather_forecast", "list_aetherytes", "search_quests"],
      "expect": {
        "calls": [],
        "forbid_any_call": true,
        "answer": { "contains_any": ["queue", "match", "party", "parties", "group"], "max_chars": 400 }
      }
    },
    {
      "id": "multi_step_status",
      "category": "multi-step",
      "prompt": "Find out where I am and what the weather is doing here next, then post a status on the agent board as agent \"almanac-bench\" saying what you found.",
      "tools": ["get_location", "get_weather_forecast", "post_status"],
      "max_steps": 8,
      "expect": {
        "calls": [ { "name": "get_location" }, { "name": "get_weather_forecast" }, { "name": "post_status", "args": { "agent": { "eq": "almanac-bench" } } } ],
        "answer": { "contains_from_tool": [ { "tool": "get_location", "path": "territory.name" } ] }
      }
    }
  ]
}
