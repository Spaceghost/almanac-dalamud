{
  "id": "ffxiv-core",
  "version": "1.0.0",
  "description": "Read-only FFXIV tasks that exercise tool use through XivMcp: location, weather, aetherytes, map flag, quest lookup, command formatting and restraint. Mock fixtures mirror XivMcp result shapes so the suite runs without the game.",
  "system_prompt": "You are Almanac, an assistant inside Final Fantasy XIV. You can call tools that read the player's game through XivMcp. Use a tool whenever the answer depends on the player's current game state or game data; do not guess such facts. Do not call tools you do not need. Answer briefly and plainly, and include the concrete values you found (names, numbers, coordinates).",
  "defaults": { "max_steps": 6, "temperature": 0, "max_tokens": 512, "weights": { "tools": 0.5, "answer": 0.5 } },
  "tools": [
    {
      "name": "get_location",
      "description": "Where the player is. Returns territory {id, name, region, zone, intendedUse}, map {id, name}, area and subArea place names, position {x,y,z}, mapCoordinates {x,y} as shown on the in-game map, current weather {id, name}, and the nearest aetheryte and aethernet shard on this map.",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "get_weather_forecast",
      "description": "Weather forecast for a zone computed with the game's deterministic weather algorithm (weather changes every 8 Eorzea hours = 23m20s real time). Returns territory, possibleWeather, and forecast: consecutive windows starting with the current one, each {weatherId, name, startUtc, endUtc, eorzeaStart, secondsUntilStart, isCurrent}. territoryId defaults to the current zone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "territoryId": { "type": "integer", "minimum": 1, "description": "TerritoryType row id. Omit for the player's current zone." },
          "count": { "type": "integer", "minimum": 1, "maximum": 24, "description": "Number of 8-bell weather windows to return, starting with the current one (1-24). Default 6." }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "list_aetherytes",
      "description": "The player's teleport list (the in-game Teleport window): every attuned aetheryte. Each entry: aetheryteId, name, territoryId, zone, region, gilCost, isFavourite, isHomePoint, isInCurrentZone. Filter with nameContains (matches aetheryte, zone or region name).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nameContains": { "type": "string", "description": "Case-insensitive substring matched against the aetheryte, zone or region name." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "description": "Maximum entries to return (1-500). Default 50." },
          "offset": { "type": "integer", "minimum": 0, "description": "Entries to skip, for paging." }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "set_map_flag",
      "description": "Places the user's map flag marker (shown on the map/minimap and inserted by <flag> in chat) and by default opens the map window on it. Pass map coordinates x and y as shown in game (roughly 1-42).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": { "type": "number", "description": "Map X coordinate as shown in game (roughly 1-42). Use with y." },
          "y": { "type": "number", "description": "Map Y coordinate as shown in game (roughly 1-42). Use with x." },
          "territoryId": { "type": "integer", "minimum": 1, "description": "TerritoryType row id; default is the current zone." },
          "openMap": { "type": "boolean", "description": "Open the map window centred on the flag." },
          "title": { "type": "string", "description": "Optional map window title." }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_quests",
      "description": "Searches quests by name (ranked exact > prefix > word > substring). Returns {total, results:[{id, name, level, genre, expansion}]}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Quest name text (any case)." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "name": "post_status",
      "description": "Shows your progress inside the player's game: creates or replaces the agent board entry for `agent` (one entry per agent name).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent": { "type": "string", "maxLength": 64, "description": "Short stable name identifying you." },
          "status": { "type": "string", "description": "One-line status text." },
          "state": { "type": "string", "enum": ["running", "done", "failed", "info"] },
          "progress": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["agent", "status"],
        "additionalProperties": false
      }
    }
  ],
  "fixtures": {
    "get_location": {
